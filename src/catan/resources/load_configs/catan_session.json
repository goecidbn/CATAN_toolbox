{
    "format_version": 1,
    "uid": "catan-session",
    "name": "CATAN session",
    "source_type": "session",
    "public": false,
    "groups": {
        "metadata": {
            "title": "Metadata",
            "type": "static",
            "enabled": true,
            "fields": {
                "path": {
                    "path": "/",
                    "source": "attribute",
                    "attribute": "path",
                    "required": false
                }
            }
        },
        "spatial": {
            "title": "Spatial data",
            "type": "static",
            "enabled": true,
            "fields": {
                "footprints": {
                    "path": "/footprints",
                    "required": true,
                    "source": "field",
                    "attribute": null
                },
                "background": {
                    "path": "/background",
                    "required": false,
                    "source": "field",
                    "attribute": null
                },
                "included": {
                    "path": "/included",
                    "required": false,
                    "source": "field",
                    "attribute": null
                }
            }
        },
        "quality": {
            "title": "Quality data",
            "type": "dynamic",
            "enabled": true,
            "fields": {
                "*": {
                    "path": "/quality/*",
                    "source": "field",
                    "attribute": null,
                    "required": false
                }
            }
        },
        "traces": {
            "title": "Trace data",
            "type": "dynamic",
            "enabled": false,
            "fields": {
                "*": {
                    "path": "/traces/*",
                    "source": "field",
                    "attribute": null,
                    "required": false
                }
            }
        }
    },
    "subconfigs": {
        "remap": {
            "path": "/remap",
            "config": "catan_remap.json",
            "required": false
        }
    },
    "native": true
}
