{
    "format_version": 1,
    "uid": "catan-model",
    "name": "CATAN model",
    "source_type": "model",
    "public": false,
    "groups": {
        "parameters": {
            "title": "Model",
            "type": "static",
            "enabled": true,
            "fields": {
                "values": {
                    "path": "/parameters",
                    "required": true,
                    "source": "field",
                    "attribute": null
                },
                "names": {
                    "path": "/",
                    "required": true,
                    "source": "attribute",
                    "attribute": "parameter_names"
                }
            }
        },
        "persistence": {
            "title": "Model state",
            "type": "static",
            "enabled": true,
            "fields": {
                "metadata": {
                    "path": "/model_metadata",
                    "source": "field",
                    "required": false
                }
            }
        },
        "count_arrays": {
            "title": "Count records",
            "type": "dynamic",
            "enabled": true,
            "fields": {
                "arrays": {
                    "path": "/counts/*",
                    "source": "field",
                    "required": false
                }
            }
        }
    },
    "native": true
}
