    "match_level": "footprint",
    "count": null,
    "comment": "Footprints that fall apart into two or more lobes (e.g. two cells detected as one), away from the image border. Cut at the neck cuts each between its two largest lobes: the part matching the neuron's other footprints stays, the other becomes a new neuron. Needs no other sessions; where the separate cells exist in other sessions, the split candidates preset uses them as the blueprint instead.",
    "apply_to": "same",
    "summary": null,
    "manipulation": {
      "kind": "cut",
      "group_id": null,
      "confirm_each": true,
